{
  "name": "htn-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @htn/api dev\" \"node --env-file-if-exists=.env scripts/wait-for-api.mjs && pnpm --filter @htn/web dev\"",
    "dev:api": "pnpm --filter @htn/api dev",
    "dev:web": "pnpm --filter @htn/web dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm run check:all && pnpm --filter @htn/web test",
    "check:all": "pnpm run check:graph && pnpm run check:graph-critique && pnpm --filter @htn/api check:graph-compile && pnpm --filter @htn/api check:benchmark && pnpm --filter @htn/api check:reuse && pnpm run check:jev:decisions && pnpm run check:agent-single-run && pnpm run check:model-gateway && pnpm run check:mcp-gateway && pnpm run check:mcp-connections && pnpm run check:sqlite-store && pnpm run check:tool-broker && pnpm run check:composio-catalog && pnpm --filter @htn/api check:composio-results && pnpm run check:browser-tools && pnpm --filter @htn/api check:target-memory && pnpm run check:content-check && pnpm run check:gemini && pnpm run check:anthropic && pnpm run check:credentials && pnpm run check:search && pnpm run check:browser-integration && pnpm run check:browser-http && pnpm run check:action-workspace && pnpm run check:authoring-mock",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "build": "pnpm --filter @htn/web build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/live-check.mjs",
    "check:graph": "pnpm --filter @htn/api check:graph",
    "check:graph-critique": "pnpm --filter @htn/api check:graph-critique",
    "check:graphs": "pnpm --filter @htn/api check:graphs",
    "check:analytics": "pnpm --filter @htn/api check:analytics",
    "check:jev:decisions": "pnpm --filter @htn/api check:jev:decisions",
    "check:agent-single-run": "pnpm --filter @htn/api check:agent-single-run",
    "check:model-gateway": "pnpm --filter @htn/api check:model-gateway",
    "check:mcp-gateway": "pnpm --filter @htn/api check:mcp-gateway",
    "check:mcp-connections": "pnpm --filter @htn/api check:mcp-connections",
    "check:sqlite-store": "pnpm --filter @htn/api check:sqlite-store",
    "check:tool-broker": "pnpm --filter @htn/api check:tool-broker",
    "check:composio-catalog": "pnpm --filter @htn/api check:composio-catalog",
    "check:content-check": "pnpm --filter @htn/api check:content-check",
    "check:gemini": "pnpm --filter @htn/api check:gemini",
    "check:anthropic": "pnpm --filter @htn/api check:anthropic",
    "check:browser-tools": "pnpm --filter @htn/api check:browser-tools",
    "check:browser-integration": "pnpm --filter @htn/api check:browser-integration",
    "check:browser-http": "pnpm --filter @htn/api check:browser-http",
    "check:browser-local-http": "pnpm --filter @htn/api check:browser-local-http",
    "check:action-workspace": "pnpm --filter @htn/api check:action-workspace",
    "check:authoring-mock": "pnpm --filter @htn/api check:authoring-mock",
    "check:composio-readonly": "pnpm --filter @htn/api check:composio-readonly",
    "check:browser-live": "pnpm --filter @htn/api check:browser-live",
    "check:credentials": "pnpm --filter @htn/api check:credentials",
    "check:search": "pnpm --filter @htn/api check:search",
    "check:providers": "pnpm --filter @htn/api check:providers",
    "test:jev": "pnpm --filter @htn/api test:jev",
    "test:jev:routing": "pnpm --filter @htn/api test:jev:routing",
    "bench:browser": "pnpm --filter @htn/api bench:browser"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.23.0"
  }
}
