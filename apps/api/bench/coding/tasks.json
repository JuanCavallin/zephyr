      "id": "strkit-table-pad",
      "repo": "strkit",
      "kind": "feature",
      "origin": "benchmark report table in apps/api/scripts/benchmark.ts",
      "prompt": "Add src/table.mjs exporting padTable(rows): align rows of cells into columns, each column as wide as its widest cell, columns two spaces apart, no trailing spaces. Returns an array of lines.",
      "hiddenTest": "hidden/strkit-table-pad.test.mjs",
      "solution": [
        {
          "tool": "Write",
          "path": "src/table.mjs",
          "content": "/** Align rows of cells into columns, two spaces apart, no trailing spaces. */\nexport function padTable(rows) {\n  const widths = [];\n  for (const row of rows) row.forEach((cell, i) => (widths[i] = Math.max(widths[i] ?? 0, String(cell).length)));\n  return rows.map((row) => row.map((cell, i) => String(cell).padEnd(widths[i])).join('  ').trimEnd());\n}\n"
        },
        {
          "tool": "Bash",
          "command": "npm test"
        }
      ]
